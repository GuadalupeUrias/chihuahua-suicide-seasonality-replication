# Datos crudos: NO se suben al repositorio (son pesados y de fuente pública fácilmente
# re-descargable siguiendo docs/DATA_SOURCES.md — no tiene sentido versionarlos en git).
data/raw/*
!data/raw/.gitkeep

# Datos intermedios (salidas del notebook de descarga, ej. parquet por año): tampoco se suben,
# se regeneran corriendo notebooks/01_download_extract_mortalidad.ipynb.
data/interim/*
!data/interim/.gitkeep

# Entornos y cachés de Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
